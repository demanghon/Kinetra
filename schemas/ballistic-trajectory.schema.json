{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetra.golf/schemas/ballistic-trajectory.schema.json",
  "title": "BallisticTrajectoryResult",
  "description": "3D ballistic launch vector, aerodynamic flight metrics, range_ball vs tour_ball comparison, and Dry Swing support.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_id",
    "fusion_mode",
    "is_dry_swing",
    "is_virtual_ball",
    "launch_conditions",
    "flight_summary",
    "trajectory_points_50hz"
  ],
  "properties": {
    "capture_id": {
      "type": "string"
    },
    "fusion_mode": {
      "type": "string",
      "enum": [
        "HYBRID_IMU_AND_DTL_VIDEO",
        "AUTONOMOUS_IMU_FACE_ON",
        "DRY_SWING_VIRTUAL_BALL",
        "DRY_SWING_KINEMATICS_ONLY"
      ]
    },
    "is_dry_swing": {
      "type": "boolean"
    },
    "is_virtual_ball": {
      "type": "boolean"
    },
    "launch_conditions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "ball_speed_mps",
        "smash_factor",
        "vertical_launch_angle_deg",
        "horizontal_launch_angle_deg",
        "total_spin_rpm",
        "backspin_rpm",
        "sidespin_rpm",
        "spin_axis_tilt_deg"
      ],
      "properties": {
        "ball_speed_mps": { "type": "number", "minimum": 5.0, "maximum": 100.0 },
        "smash_factor": { "type": "number", "minimum": 0.80, "maximum": 1.52 },
        "vertical_launch_angle_deg": { "type": "number", "minimum": 0.0, "maximum": 60.0 },
        "horizontal_launch_angle_deg": { "type": "number", "minimum": -30.0, "maximum": 30.0 },
        "total_spin_rpm": { "type": "number", "minimum": 500.0, "maximum": 14000.0 },
        "backspin_rpm": { "type": "number", "minimum": 500.0, "maximum": 14000.0 },
        "sidespin_rpm": { "type": "number", "minimum": -5000.0, "maximum": 5000.0 },
        "spin_axis_tilt_deg": { "type": "number", "minimum": -45.0, "maximum": 45.0 }
      }
    },
    "flight_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "active_ball_type",
        "carry_distance_m",
        "roll_distance_m",
        "total_distance_m",
        "lateral_offline_carry_m",
        "lateral_offline_total_m",
        "apex_height_m",
        "landing_angle_deg",
        "flight_time_s",
        "tour_ball_equivalent_carry_m"
      ],
      "properties": {
        "active_ball_type": { "type": "string", "enum": ["tour_ball", "range_ball"] },
        "carry_distance_m": { "type": "number", "minimum": 0.0, "maximum": 380.0 },
        "roll_distance_m": { "type": "number", "minimum": -10.0, "maximum": 80.0 },
        "total_distance_m": { "type": "number", "minimum": 0.0, "maximum": 420.0 },
        "lateral_offline_carry_m": { "type": "number", "minimum": -100.0, "maximum": 100.0 },
        "lateral_offline_total_m": { "type": "number", "minimum": -120.0, "maximum": 120.0 },
        "apex_height_m": { "type": "number", "minimum": 0.0, "maximum": 70.0 },
        "landing_angle_deg": { "type": "number", "minimum": 0.0, "maximum": 75.0 },
        "flight_time_s": { "type": "number", "minimum": 0.0, "maximum": 12.0 },
        "tour_ball_equivalent_carry_m": { "type": "number", "minimum": 0.0, "maximum": 380.0 }
      }
    },
    "trajectory_points_50hz": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t_s", "x_m", "y_m", "z_m", "phase"],
        "properties": {
          "t_s": { "type": "number", "minimum": 0.0 },
          "x_m": { "type": "number" },
          "y_m": { "type": "number" },
          "z_m": { "type": "number", "minimum": 0.0 },
          "phase": { "type": "string", "enum": ["airborne", "bounce", "roll"] }
        }
      }
    }
  }
}
